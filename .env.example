# ---- Site identity (public) ----
# Production: https://yojilabs.com  · Preview: leave unset (falls back to the Vercel URL)
NEXT_PUBLIC_SITE_URL=
# local | preview | production — normally derived from VERCEL_ENV; set only to override
NEXT_PUBLIC_DEPLOYMENT_STAGE=

# ---- Integrations (public) ----
# Cal.com link, e.g. yojilabs/intro. Unset → "Request a time" fallback card on /start-a-project/book
NEXT_PUBLIC_CAL_LINK=
# Cloudflare Turnstile site key. Unset → widget hidden (honeypot + timing still enforced)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Embed URL of the recorded Pantry walkthrough (Arcade / Supademo). Unset → in-page preview
NEXT_PUBLIC_PANTRY_TOUR_URL=
# Set to "live" to hit the real /api routes on localhost instead of mocks
NEXT_PUBLIC_FORMS_MODE=

# ---- Server-only secrets ----
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
# Optional overrides; defaults are "YojiLabs <hello@yojilabs.com>" and hello@yojilabs.com
CONTACT_FROM_ADDRESS=
CONTACT_TO_ADDRESS=

# ---- External apps ----
NEXT_PUBLIC_PANTRY_APP_URL=
